{% extends 'base.html.twig' %}

{% block title %}Owner index{% endblock %}

{% block body %}
    <style>
        body {
            background-color: #eaf7f7;
            font-family: 'Helvetica', sans-serif;
            color: #333;
        }

        h1 {
            text-align: center;
            margin-top: 20px;
            color: #2b7a78;
            font-weight: 600;
        }

        .table {
            width: 80%;
            margin: 20px auto;
            border-collapse: collapse;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            background-color: #ffffff;
            border-radius: 8px;
            overflow: hidden;
        }

        .table th, .table td {
            padding: 15px;
            border-bottom: 1px solid #dddddd;
            text-align: left;
        }

        .table th {
            background-color: #3aafa9;
            color: white;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .table tr:nth-child(even) {
            background-color: #f0f9f9;
        }

        .table tr:hover {
            background-color: #d0eeee;
        }

        .table-actions a {
            margin-right: 10px;
            padding: 8px 12px;
            background-color: #2b7a78;
            color: white;
            text-decoration: none;
            border-radius: 4px;
        }

        .table-actions a:hover {
            background-color: #276c6b;
        }

        .create-new {
            display: block;
            width: 200px;
            margin: 30px auto;
            text-align: center;
            padding: 12px;
            background-color: #f6b93b;
            color: white;
            text-decoration: none;
            font-weight: bold;
            border-radius: 6px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
        }

        .create-new:hover {
            background-color: #e58e26;
        }

        .no-records {
            text-align: center;
            padding: 20px;
            color: #555;
            font-style: italic;
        }
    </style>

    <h1>Owner Management</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Firstname</th>
                <th>Lastname</th>
                <th>Mail</th>
                <th>Password</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for owner in owners %}
            <tr>
                <td>{{ owner.id }}</td>
                <td>{{ owner.firstname }}</td>
                <td>{{ owner.lastname }}</td>
                <td>{{ owner.mail }}</td>
                <td>{{ owner.password }}</td>
                <td class="table-actions">
                    <a href="{{ path('app_owner_show', {'id': owner.id}) }}">View</a>
                    <a href="{{ path('app_owner_edit', {'id': owner.id}) }}">Edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="no-records">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="create-new" href="{{ path('app_owner_new') }}">Create New Owner</a>
{% endblock %}
